
# Copy to .env and fill in values before running

# When running producer locally (outside Docker): localhost:9092
# When running producer inside Docker network:    kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_TOPIC=banking-transactions

# Path to the downloaded Kaggle CSV
CSV_FILE_PATH=data/transactions.csv

# Events flushed to Kafka per batch
PRODUCER_BATCH_SIZE=500

PIPELINE_VERSION=1.0.0
